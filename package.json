{
  "name": "jobposted",
  "version": "0.1.0",
  "private": true,
  "description": "AI job-application platform — find matching jobs, tailor a resume per role (via Rezoomed), fill the form, confirm, submit.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.7.3"
  }
}
