{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "AZURE_AI_FOUNDRY_ENDPOINT",
    "AZURE_AI_FOUNDRY_API_KEY",
    "AZURE_AI_FOUNDRY_MODELS",
    "MICROSOFT_FOUNDRY_ENDPOINT",
    "MICROSOFT_FOUNDRY_API_KEY",
    "MICROSOFT_FOUNDRY_MODELS",
    "FOUNDRY_ENDPOINT",
    "FOUNDRY_API_KEY",
    "FOUNDRY_MODELS",
    "FOUNDRY_PRIMARY_TIMEOUT_MS",
    "FOUNDRY_SECONDARY_TIMEOUT_MS",
    "LLM_PROVIDER_ORDER",
    "OPENROUTER_API_KEY",
    "OPENROUTER_BASE_URL",
    "OPENROUTER_MODEL",
    "OPENROUTER_TIMEOUT_MS",
    "FIELD_MAP_TIMEOUT_MS",
    "AUTOFILL_MODEL",
    "AUTOFILL_PLAN_TIMEOUT_MS",
    "OPENAI_API_KEY",
    "EMBEDDING_MODEL",
    "JOBPOSTED_DAILY_PREP_LIMIT",
    "JOBPOSTED_DAILY_CANDIDATE_LIMIT",
    "JOBPOSTED_BULK_USER_PAGE_SIZE",
    "JOBPOSTED_BULK_CONCURRENCY",
    "INGEST_BOARDS_FILE",
    "INGEST_QUESTIONS",
    "INGEST_CLOSE_AFTER_DAYS",
    "WORKER_CRON_SECRET",
    "QUEUE_RENDER_LIMIT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
