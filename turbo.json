{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "OPENROUTER_API_KEY",
    "OPENAI_API_KEY",
    "AI_GATEWAY_API_KEY",
    "AI_GATEWAY_BASE_URL",
    "AI_GATEWAY_MODEL",
    "VERCEL_OIDC_TOKEN",
    "EMBEDDING_MODEL",
    "JOBPOSTED_DAILY_PREP_LIMIT",
    "JOBPOSTED_DAILY_CANDIDATE_LIMIT",
    "JOBPOSTED_BULK_USER_PAGE_SIZE",
    "JOBPOSTED_BULK_CONCURRENCY",
    "INGEST_BOARDS_FILE",
    "INGEST_QUESTIONS",
    "INGEST_CLOSE_AFTER_DAYS",
    "WORKER_CRON_SECRET",
    "QUEUE_RENDER_LIMIT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
