# JobPosted — environment reference (design doc §4)
# Copy the relevant block into apps/web/.env.local or apps/ingest/.env.
# Only .env.example is committed; real .env files are gitignored.
#
# Phase tags show when each var is first needed. Phase 0/1 (this build) only
# strictly needs SITE_URL, the Supabase trio, and — optionally — an embedding key.

# ── Site ────────────────────────────────────────────────────────────────────
# Domain is undecided; use any placeholder until the real one is wired.
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # [Phase 0]

# ── Supabase (shared with Rezoomed) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                          # [Phase 0]
NEXT_PUBLIC_SUPABASE_ANON_KEY=                     # [Phase 0]
SUPABASE_SERVICE_ROLE_KEY=                         # [Phase 0] server only, NEVER ship to client

# ── Embeddings (ingestion match scoring) ────────────────────────────────────
# Optional in this build: ingest fetch+normalize runs without a key (embeddings no-op).
OPENROUTER_API_KEY=                                # [Phase 1+] server-side AI via OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # [Phase 1+] OpenAI-compatible OpenRouter endpoint
OPENROUTER_MODEL=deepseek/deepseek-chat            # [Phase 1+] e.g. deepseek/deepseek-chat or google/gemini-2.5-flash
OPENROUTER_TIMEOUT_MS=12000                        # [Phase 1+] timeout for short field-mapping calls
OPENAI_API_KEY=                                    # [Phase 1] alt embeddings provider
AI_GATEWAY_API_KEY=                                # [Phase 5] legacy fallback: Vercel AI Gateway
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1 # [Phase 5] legacy fallback gateway base URL
AI_GATEWAY_MODEL=                                  # [Phase 5] legacy fallback model
AI_GATEWAY_TIMEOUT_MS=12000                        # [Phase 5] timeout for ambiguous extension field mapping
EMBEDDING_MODEL=text-embedding-3-small             # [Phase 1] 1536-dim default
ANTHROPIC_API_KEY=                                 # [Phase 3] Claude vision for hard pages

# ── Job data sources ────────────────────────────────────────────────────────
# Lever + Greenhouse public feeds need NO key. These are for breadth (later).
CRON_SECRET=                                       # [Phase 3] Vercel cron auth header for /api/ingest/cron
INGEST_CRON_SECRET=                                # [Phase 3] optional, protects /api/ingest/cron
INGEST_BOARDS_FILE=                                # [Phase 1] local/worker path to board config JSON
INGEST_QUESTIONS=0                                 # [Phase 3] set 1 to fetch supported ATS form questions
INGEST_CLOSE_AFTER_DAYS=45                         # [Phase 3] mark jobs stale if not seen again
ADZUNA_APP_ID=                                     # [Phase 1+]
ADZUNA_APP_KEY=                                    # [Phase 1+]
RAPIDAPI_KEY=                                      # [Phase 1+] JSearch
APIFY_TOKEN=                                       # [Phase 1+] India scrapers

# ── Rezoomed tailoring (internal service) ───────────────────────────────────
REZOOMED_API_URL=                                  # [Phase 3]
REZOOMED_API_KEY=                                  # [Phase 3]

# ── Payments ────────────────────────────────────────────────────────────────
CREEM_API_KEY=                                     # [Phase 4] creates checkout + customer portal links
CREEM_TEST_MODE=false                              # [Phase 4] true uses https://test-api.creem.io
CREEM_WEBHOOK_SECRET=                              # [Phase 4] optional alias for BILLING_WEBHOOK_SECRET
CREEM_MONTHLY_PRODUCT_ID=                          # [Phase 4] global fallback monthly product
CREEM_QUARTERLY_PRODUCT_ID=                        # [Phase 4] global fallback quarterly product
CREEM_PRODUCT_ID=                                  # [Phase 4] legacy monthly fallback
CREEM_US_MONTHLY_PRODUCT_ID=                       # [Phase 4] USD monthly product
CREEM_US_QUARTERLY_PRODUCT_ID=                     # [Phase 4] USD quarterly product
CREEM_EU_MONTHLY_PRODUCT_ID=                       # [Phase 4] EUR monthly product
CREEM_EU_QUARTERLY_PRODUCT_ID=                     # [Phase 4] EUR quarterly product
CREEM_GB_MONTHLY_PRODUCT_ID=                       # [Phase 4] GBP monthly product
CREEM_GB_QUARTERLY_PRODUCT_ID=                     # [Phase 4] GBP quarterly product
CREEM_IN_MONTHLY_PRODUCT_ID=                       # [Phase 4] INR monthly product
CREEM_IN_QUARTERLY_PRODUCT_ID=                     # [Phase 4] INR quarterly product
CREEM_AU_MONTHLY_PRODUCT_ID=                       # [Phase 4] AUD monthly product
CREEM_AU_QUARTERLY_PRODUCT_ID=                     # [Phase 4] AUD quarterly product
CREEM_CA_MONTHLY_PRODUCT_ID=                       # [Phase 4] CAD monthly product
CREEM_CA_QUARTERLY_PRODUCT_ID=                     # [Phase 4] CAD quarterly product
BILLING_US_MONTHLY_PRICE_LABEL=$19.99              # [Phase 4] displayed price label
BILLING_US_QUARTERLY_PRICE_LABEL=$39.99            # [Phase 4] displayed price label
BILLING_EU_MONTHLY_PRICE_LABEL=                    # [Phase 4] e.g. EUR local price label
BILLING_EU_QUARTERLY_PRICE_LABEL=
BILLING_GB_MONTHLY_PRICE_LABEL=                    # [Phase 4] e.g. GBP local price label
BILLING_GB_QUARTERLY_PRICE_LABEL=
BILLING_IN_MONTHLY_PRICE_LABEL=                    # [Phase 4] e.g. INR local price label
BILLING_IN_QUARTERLY_PRICE_LABEL=
BILLING_AU_MONTHLY_PRICE_LABEL=                    # [Phase 4] e.g. AUD local price label
BILLING_AU_QUARTERLY_PRICE_LABEL=
BILLING_CA_MONTHLY_PRICE_LABEL=                    # [Phase 4] e.g. CAD local price label
BILLING_CA_QUARTERLY_PRICE_LABEL=
BILLING_PROVIDER=creem                             # [Phase 4] label stored on subscription rows
BILLING_WEBHOOK_SECRET=                            # [Phase 4] HMAC secret expected by /api/billing/webhook
CHECKOUT_PRO_50_URL=                               # [Phase 4] legacy monthly hosted checkout URL
CHECKOUT_QUARTERLY_URL=                            # [Phase 4] legacy quarterly hosted checkout URL

# ── Email + analytics + errors ──────────────────────────────────────────────
RESEND_API_KEY=                                    # [Phase 4]
NEXT_PUBLIC_POSTHOG_KEY=                            # [Phase 0] optional
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com  # [Phase 0]
SENTRY_DSN=                                         # [Phase 3+]
ERROR_REPORTING_WEBHOOK_URL=                       # [Phase 3+] optional JSON error sink for web/worker

# ── Apply worker ────────────────────────────────────────────────────────────
JOBPOSTED_WEB_URL=                                 # [Phase 3] worker target, defaults can use NEXT_PUBLIC_SITE_URL
JOBPOSTED_DAILY_PREP_LIMIT=16                      # [Phase 3] max jobs prepared per user per cron run
JOBPOSTED_DAILY_CANDIDATE_LIMIT=500                # [Phase 3] max recent jobs scored per user per run
JOBPOSTED_BULK_USER_PAGE_SIZE=200                  # [Phase 3] queue-prep pagination size
JOBPOSTED_BULK_CONCURRENCY=4                       # [Phase 3] bounded queue-prep user concurrency
BROWSER_PROXY_URL=                                 # [Phase 3] residential/ISP proxy (at volume)
WORKER_PORT=8080                                   # [Phase 3] Railway health endpoint
WORKER_CRON_SECRET=                                # [Phase 3] shared secret for cron-triggered worker runs
WORKER_POLL_MS=4000                                # [Phase 3] optional long-running poll interval
APPLY_RUNNER_ENABLED=0                             # [Phase 3] 1 enables server-side apply runner endpoints
APPLY_DRY_RUN=1                                    # [Phase 3] 0 clicks submit on server-safe ATS
APPLY_BATCH=10                                     # [Phase 3] applications claimed per worker run
APPLY_MAX_ATTEMPTS=3                               # [Phase 3] retry cap before failure/review
APPLY_RUNNER_ON_CRON=1                             # [Phase 3] 0 skips apply inside /cron/run
QUEUE_RENDER_ON_CRON=1                             # [Phase 3] 0 skips tailored PDF rendering inside /cron/run
QUEUE_RENDER_LIMIT=8                               # [Phase 3] applications rendered per cron tick
DOCUMENT_CLEANUP_ON_CRON=1                         # [Phase 3] set 0 to skip retention after /cron/run
DOCUMENT_RETENTION_DAYS=14                         # [Phase 3] hot window for transient tailored renders
DOCUMENT_CLEANUP_BATCH=500                         # [Phase 3] stale document rows considered per pass
DOCUMENT_CLEANUP_STORAGE_SCAN_LIMIT=1000           # [Phase 3] stale storage objects considered per pass
DOCUMENT_CLEANUP_STORAGE_USER_LIMIT=1000           # [Phase 3] user folders scanned per pass

# ── Chrome extension build-time env ─────────────────────────────────────────
WXT_JOBPOSTED_WEB_ORIGIN=http://localhost:3000      # local now; set live domain when deployed
WXT_SUPABASE_URL=                                   # Supabase URL bundled for session refresh
WXT_SUPABASE_ANON_KEY=                              # Supabase anon key bundled for session refresh
WXT_INCLUDE_LOCALHOST=1                             # include localhost bridge host while local-only
