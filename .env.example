# JobPosted — environment reference (design doc §4)
# Copy the relevant block into apps/web/.env.local or apps/ingest/.env.
# Only .env.example is committed; real .env files are gitignored.
#
# Phase tags show when each var is first needed. Phase 0/1 (this build) only
# strictly needs SITE_URL, the Supabase trio, and — optionally — an embedding key.

# ── Site ────────────────────────────────────────────────────────────────────
# Domain is undecided; use any placeholder until the real one is wired.
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # [Phase 0]

# ── Supabase (shared with Rezoomed) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                          # [Phase 0]
NEXT_PUBLIC_SUPABASE_ANON_KEY=                     # [Phase 0]
SUPABASE_SERVICE_ROLE_KEY=                         # [Phase 0] server only, NEVER ship to client

# ── Embeddings (ingestion match scoring) ────────────────────────────────────
# Optional in this build: ingest fetch+normalize runs without a key (embeddings no-op).
OPENROUTER_API_KEY=                                # [Phase 1] DeepSeek + fallbacks
OPENAI_API_KEY=                                    # [Phase 1] alt embeddings provider
EMBEDDING_MODEL=text-embedding-3-small             # [Phase 1] 1536-dim default
ANTHROPIC_API_KEY=                                 # [Phase 3] Claude vision for hard pages

# ── Job data sources ────────────────────────────────────────────────────────
# Lever + Greenhouse public feeds need NO key. These are for breadth (later).
ADZUNA_APP_ID=                                     # [Phase 1+]
ADZUNA_APP_KEY=                                    # [Phase 1+]
RAPIDAPI_KEY=                                      # [Phase 1+] JSearch
APIFY_TOKEN=                                       # [Phase 1+] India scrapers

# ── Rezoomed tailoring (internal service) ───────────────────────────────────
REZOOMED_API_URL=                                  # [Phase 3]
REZOOMED_API_KEY=                                  # [Phase 3]

# ── Payments ────────────────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=                                # [Phase 4]
POLAR_WEBHOOK_SECRET=                              # [Phase 4]
RAZORPAY_KEY_ID=                                   # [Phase 4]
RAZORPAY_KEY_SECRET=                               # [Phase 4]
RAZORPAY_WEBHOOK_SECRET=                            # [Phase 4]

# ── Email + analytics + errors ──────────────────────────────────────────────
RESEND_API_KEY=                                    # [Phase 4]
NEXT_PUBLIC_POSTHOG_KEY=                            # [Phase 0] optional
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com  # [Phase 0]
SENTRY_DSN=                                         # [Phase 3+]

# ── Apply worker ────────────────────────────────────────────────────────────
BROWSER_PROXY_URL=                                 # [Phase 3] residential/ISP proxy (at volume)
