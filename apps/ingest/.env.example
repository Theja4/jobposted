# apps/ingest — copy to .env. Fetch + normalize + dedupe run with NONE of these set
# (embeddings and DB writes simply no-op). They're only needed to persist jobs.

# Supabase (shared with Rezoomed) — service role for upserts into jobposted.jobs
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings (optional; without a key jobs.embedding stays null)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Scheduler input: a board_tokens.json (see packages/db/seed/board_tokens.example.json)
INGEST_BOARDS_FILE=../../packages/db/seed/board_tokens.example.json
INGEST_QUESTIONS=0

# Apify — only needed for bot-protected boards (Wellfound, RemoteFront). Without these,
# those sources no-op cleanly; greenhouse/lever/ashby need nothing here (design doc §9.1).
APIFY_TOKEN=
APIFY_WELLFOUND_ACTOR=
APIFY_REMOTEFRONT_ACTOR=
