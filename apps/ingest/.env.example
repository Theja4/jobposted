# apps/ingest — copy to .env. Fetch + normalize + dedupe run with NONE of these set
# (embeddings and DB writes simply no-op). They're only needed to persist jobs.

# Supabase (shared with Rezoomed) — service role for upserts into jobposted.jobs
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings (optional; without a key jobs.embedding stays null)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional company-logo fallback. Use a Logo.dev publishable key; source-page logos are tried first.
LOGO_DEV_PUBLISHABLE_KEY=

# Scheduler input: a board_tokens.json/company registry (see packages/db/seed/board_tokens.example.json)
INGEST_BOARDS_FILE=../../packages/db/seed/board_tokens.example.json
# For Vercel/serverless, prefer JSON so the runtime does not depend on a bundled file path.
# INGEST_BOARDS_JSON={"greenhouse":["stripe"],"lever":["ramp"],"companies":[]}
# Set to 1 only if you want ingest to fail instead of using the built-in starter board list.
INGEST_DISABLE_DEFAULT_BOARDS=
INGEST_QUESTIONS=0
INGEST_CLOSE_AFTER_DAYS=30
INGEST_PURGE_CLOSED_AFTER_DAYS=30
INGEST_PURGE_CLOSED_LIMIT=1000
