{
  "name": "@jobposted/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Railway worker shell for JobPosted server-side apply jobs.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cron:cleanup": "node dist/cron-cli.js cleanup",
    "cron:run": "node dist/cron-cli.js run",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:ats": "tsx src/validate-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@jobposted/shared": "workspace:*",
    "@supabase/supabase-js": "^2.107.0",
    "playwright": "^1.60.0"
  }
}
