# apps/worker — copy to .env (set these in Railway for deploy).

# Supabase (shared) — service role; the worker bypasses RLS
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM field-matching — OpenRouter/DeepSeek only (matches Rezoomed); Anthropic is OPTIONAL.
OPENROUTER_API_KEY=                 # required for custom-field answering
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_API_KEY=                # optional — enables the vision fallback for hard/unlabeled
#                                     fields. Leave unset to run DeepSeek-only (standard fields
#                                     still fill deterministically).

# Anti-detection (design doc §11.5) — optional until submitting at volume
BROWSER_PROXY_URL=                  # e.g. http://user:pass@host:port (per-user residential)

# Observability
SENTRY_DSN=

# Tuning
WORKER_POLL_MS=5000                 # queue poll interval
WORKER_CONCURRENCY=2                # max simultaneous browser contexts
WORKER_HEADLESS=true               # set false to watch it run locally
DAILY_CEILING_DIRECT_ATS=100        # per-user/day safety cap on direct ATS (design doc §1)
