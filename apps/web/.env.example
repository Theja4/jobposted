# apps/web — copy to .env.local. See repo-root .env.example for the full reference.
# The landing page renders with NONE of these set; they enable waitlist persistence + analytics.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REZOOMED_URL=https://rezoomed.com
NEXT_PUBLIC_REZOOMED_ACCOUNT_URL=https://rezoomed.com/dashboard/account
NEXT_PUBLIC_CHROME_EXTENSION_URL=

# Supabase (shared with Rezoomed). Waitlist insert uses the service role server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production cron hooks. Vercel Cron automatically sends Authorization: Bearer $CRON_SECRET,
# so CRON_SECRET must be set for /api/ingest/cron on Vercel.
CRON_SECRET=
# WORKER_CRON_SECRET also authorizes Railway to call /api/queue/prepare.
WORKER_CRON_SECRET=
INGEST_CRON_SECRET=
JOBPOSTED_DAILY_PREP_LIMIT=20
JOBPOSTED_DAILY_CANDIDATE_LIMIT=500
JOBPOSTED_BULK_USER_PAGE_SIZE=200
JOBPOSTED_BULK_CONCURRENCY=4
QUEUE_RENDER_LIMIT=50
INGEST_BOARDS_FILE=
# Prefer this for Vercel/serverless because file paths may not exist in the deployed bundle.
INGEST_BOARDS_JSON=
# Set to 1 only if you want ingest to fail instead of using the built-in starter board list.
INGEST_DISABLE_DEFAULT_BOARDS=
INGEST_QUESTIONS=0
INGEST_CLOSE_AFTER_DAYS=30
INGEST_PURGE_CLOSED_AFTER_DAYS=30
INGEST_PURGE_CLOSED_LIMIT=1000
LOGO_DEV_PUBLISHABLE_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ERROR_REPORTING_WEBHOOK_URL=

# Server-side AI for resume parsing repair, tailoring, cover letters, and extension planning.
# Preferred provider: Microsoft Foundry. OpenRouter is the secondary fallback.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODELS=gpt-5.4-mini,DeepSeek-V4-Flash
FOUNDRY_PRIMARY_TIMEOUT_MS=30000
FOUNDRY_SECONDARY_TIMEOUT_MS=45000
LLM_PROVIDER_ORDER=foundry,openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT_MS=12000
FIELD_MAP_TIMEOUT_MS=12000
AUTOFILL_MODEL=grok-4-fast-non-reasoning
AUTOFILL_PLAN_TIMEOUT_MS=9000
# Answer assistant (Quick Answer / Improve It) for open-ended application questions
ANSWER_MODEL=gpt-5.4-mini
ANSWER_IMPROVE_MODEL=gpt-5.4-nano
ANSWER_TIMEOUT_MS=20000

# API rate limits. Backed by the jobposted.api_rate_limits table.
RATE_LIMIT_TAILOR_PER_HOUR=20
RATE_LIMIT_RESUME_PARSE_PER_HOUR=12
RATE_LIMIT_FIELD_MAP_PER_HOUR=120
RATE_LIMIT_ANSWER_DRAFT_PER_HOUR=60
RATE_LIMIT_EXTENSION_SESSION_PER_HOUR=120
RATE_LIMIT_WAITLIST_PER_HOUR=10

# Google sign-in (ID-token flow). Use a JobPosted-owned Google OAuth Web client so the
# consent screen is branded "JobPosted" — NOT the shared Rezoomed client. Add this same
# client ID to Supabase → Auth → Google → "Authorized Client IDs". Leave blank to hide
# the Google button and fall back to email/password.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# PostHog (optional — CTAs no-op without it)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Billing checkout + webhook. Preferred: use CREEM_API_KEY + product IDs so
# JobPosted creates checkout sessions and attaches user metadata. Hosted
# checkout URLs remain as a legacy fallback.
BILLING_PROVIDER=creem
CREEM_API_KEY=
CREEM_TEST_MODE=false
CREEM_WEBHOOK_SECRET=
CREEM_MONTHLY_PRODUCT_ID=
CREEM_QUARTERLY_PRODUCT_ID=
CREEM_PRODUCT_ID=
CREEM_US_MONTHLY_PRODUCT_ID=
CREEM_US_QUARTERLY_PRODUCT_ID=
CREEM_EU_MONTHLY_PRODUCT_ID=
CREEM_EU_QUARTERLY_PRODUCT_ID=
CREEM_GB_MONTHLY_PRODUCT_ID=
CREEM_GB_QUARTERLY_PRODUCT_ID=
CREEM_IN_MONTHLY_PRODUCT_ID=
CREEM_IN_QUARTERLY_PRODUCT_ID=
CREEM_AU_MONTHLY_PRODUCT_ID=
CREEM_AU_QUARTERLY_PRODUCT_ID=
CREEM_CA_MONTHLY_PRODUCT_ID=
CREEM_CA_QUARTERLY_PRODUCT_ID=
BILLING_US_MONTHLY_PRICE_LABEL=$19.99
BILLING_US_QUARTERLY_PRICE_LABEL=$39.99
BILLING_EU_MONTHLY_PRICE_LABEL=
BILLING_EU_QUARTERLY_PRICE_LABEL=
BILLING_GB_MONTHLY_PRICE_LABEL=
BILLING_GB_QUARTERLY_PRICE_LABEL=
BILLING_IN_MONTHLY_PRICE_LABEL=
BILLING_IN_QUARTERLY_PRICE_LABEL=
BILLING_AU_MONTHLY_PRICE_LABEL=
BILLING_AU_QUARTERLY_PRICE_LABEL=
BILLING_CA_MONTHLY_PRICE_LABEL=
BILLING_CA_QUARTERLY_PRICE_LABEL=
BILLING_WEBHOOK_SECRET=
CHECKOUT_URL=
CHECKOUT_PRO_50_URL=
CHECKOUT_QUARTERLY_URL=
