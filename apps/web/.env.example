# apps/web — copy to .env.local. See repo-root .env.example for the full reference.
# The landing page renders with NONE of these set; they enable waitlist persistence + analytics.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (shared with Rezoomed). Waitlist insert uses the service role server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (optional — CTAs no-op without it)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Billing — Polar (Phase 4). Checkout shows "coming soon" until these are set.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=production            # or "sandbox"
POLAR_STARTER_PRODUCT_ID=               # the $19 Starter product
POLAR_PRO_PRODUCT_ID=                   # the $49 Pro product

# Transactional email — Resend (Phase 4). No-op without the key.
RESEND_API_KEY=
EMAIL_FROM=JobPosted <hello@jobposted.app>
EMAIL_SERVICE_TOKEN=                    # shared secret: worker → /api/email/submission
CRON_SECRET=                            # guards /api/cron/email (Vercel Cron)

# Field-match endpoint (extension, Phase 5)
FIELD_MATCH_SERVICE_TOKEN=
